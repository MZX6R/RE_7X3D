-- Target Size Input
Tabs.PVP:AddInput("TargetSize", {
    Title = "Target Size (X,Y,Z)",
    Default = "20,20,20",
    Placeholder = "20,20,20",
    Numeric = false,
    Finished = true,
    Callback = function(Value)
        local values = {}
        for value in string.gmatch(Value, "[^,]+") do
            local num = tonumber(value)
            if num then table.insert(values, num) end
        end
        
        if #values == 3 then
            Config.Target.Size = Vector3.new(values[1], values[2], values[3])
            Fluent:Notify({
                Title = "Size Updated",
                Content = string.format("Set to %.1f,%.1f,%.1f", values[1], values[2], values[3]),
                Duration = 3
            })
        else
            Fluent:Notify({
                Title = "Error",
                Content = "Please use format: X,Y,Z",
                Duration = 3
            })
        end
    end
})

